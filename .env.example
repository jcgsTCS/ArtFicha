VITE_SUPABASE_PROJECT_ID=your-supabase-project-id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Supabase Edge Function secrets, set with:
# supabase secrets set GROQ_API_KEY=...
# supabase secrets set GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# supabase secrets set ALLOWED_ORIGINS=http://localhost:8080,https://your-domain.com

# Local one-shot admin bootstrap. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_EMAIL=admin@artficha.local
ADMIN_PASSWORD=optional-strong-temporary-password
